{
  "name": "lumera",
  "version": "1.0.0",
  "private": true,
  "description": "LUMERA — پلتفرم رزرو آنلاین خدمات زیبایی و مراقبتی",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "shots": "node scripts/shots.mjs",
    "qa": "npm run typecheck && npm run lint && npm run build",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\" \"*.{json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\""
  },
  "dependencies": {
    "@fontsource/vazirmatn": "5.3.0",
    "clsx": "2.1.1",
    "next": "16.3.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tailwind-merge": "3.3.1",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "prettier": "^3.6.2",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
